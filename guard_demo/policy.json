{
  "mode": "projection",
  "sensitive_dirs": [
    "config"
  ],
  "protected_edit_paths": [
    "tests/"
  ],
  "anchors": [
    {
      "path": "config/app.env",
      "field": "API_KEY"
    }
  ],
  "safe_schema_by_file": {
    "config/app.env": {
      "TIMEOUT": {
        "type": "int",
        "min": 1,
        "max": 600
      },
      "MAX_RETRIES": {
        "type": "int",
        "min": 0,
        "max": 10
      },
      "API_BASE_URL": {
        "type": "url",
        "allowed_hosts": [
          "api.example.internal"
        ],
        "allowed_paths": [
          "/v1"
        ]
      },
      "AWS_REGION": {
        "type": "regex",
        "pattern": "^[a-z]{2}-[a-z]+-[0-9]$"
      }
    },
    "config/route0.env": {
      "TIMEOUT": {
        "type": "int",
        "min": 1,
        "max": 600
      },
      "MAX_RETRIES": {
        "type": "int",
        "min": 0,
        "max": 10
      },
      "API_BASE_URL": {
        "type": "url",
        "allowed_hosts": [
          "route0.example.internal"
        ],
        "allowed_paths": [
          "/"
        ]
      }
    },
    "config/route1.env": {
      "TIMEOUT": {
        "type": "int",
        "min": 1,
        "max": 600
      },
      "MAX_RETRIES": {
        "type": "int",
        "min": 0,
        "max": 10
      },
      "API_BASE_URL": {
        "type": "url",
        "allowed_hosts": [
          "route1.example.internal"
        ],
        "allowed_paths": [
          "/"
        ]
      }
    },
    "deploy/runtime.env": {
      "TIMEOUT": {
        "type": "int",
        "min": 1,
        "max": 600
      }
    }
  },
  "schema_mode": "file-object"
}