{
  "description": "Runtime tool guard for the invoice summarizer service",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/guard_codex.js dynamic codex",
            "timeout": 30,
            "statusMessage": "Checking tool call"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/guard_codex.js dynamic codex",
            "timeout": 30,
            "statusMessage": "Checking tool output"
          }
        ]
      }
    ]
  }
}