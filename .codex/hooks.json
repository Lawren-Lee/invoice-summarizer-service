{
  "description": "Local coding-agent guard for Codex",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/codex_guard.js",
            "timeout": 30,
            "statusMessage": "Checking tool call"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/codex_guard.js",
            "timeout": 30,
            "statusMessage": "Checking tool output"
          }
        ]
      }
    ]
  }
}